<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <!--
    Post-install: register Slime Smol USB-serial INFs via pnputil (same paths as NSIS: INSTALLDIR\resources\windows-driver\).
    Deferred + Impersonate=no runs as SYSTEM (typical for per-machine MSI), sufficient for pnputil /add-driver.
    Requires WixUtilExtension (WixQuietExec); Tauri candle adds -ext WixUtilExtension when this xmlns is present.
  -->
  <Fragment>
    <CustomAction
      Id="FoxDockSetSlimePnputilCmd"
      Property="WixQuietExecCmdLine"
      Value="&quot;[System64Folder]cmd.exe&quot; /c &quot;[System64Folder]pnputil.exe&quot; /add-driver &quot;[INSTALLDIR]resources\windows-driver\slime_smol_tracker.inf&quot; /install &amp;&amp; &quot;[System64Folder]pnputil.exe&quot; /add-driver &quot;[INSTALLDIR]resources\windows-driver\slime_smol_receiver.inf&quot; /install" />

    <!-- Return=ignore：无签名目录包时 pnputil 可能失败，仍完成应用安装；INF 保留在 resources\windows-driver\ 供手动安装 -->
    <CustomAction
      Id="FoxDockExecSlimePnputil"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="FoxDockSetSlimePnputilCmd" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="FoxDockExecSlimePnputil" After="FoxDockSetSlimePnputilCmd">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
