{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "foxdock-desktop",
  "version": "0.0.0-dev.20260402.t041608.7a5d206",
  "identifier": "com.foxapplication.foxdock",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FoxDock Desktop",
        "width": 480,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "maxWidth": 480,
        "resizable": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "windows-driver/": "resources/windows-driver/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "version": "0.0.0.31325"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNkU0MzY1OUM5NzFEQzYKUldUR0haZWNaVU51OEFMSklkTjF1N1ozdk5sWVlobGJpdGJTOHNWOGN5TGtBMVYvOE10a3FtVU8K",
      "endpoints": [
        "https://foxdock.korostudio.cn/KenRouKoro/FoxDock_Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
